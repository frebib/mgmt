/[ \t]/
	{ /* skip over whitespace */ }
/[\r\n]/
	{ return Newline }

/{/
	{ return OpenBrace }
/}/
	{ return CloseBrace }
/\(/
	{ return OpenParen }
/\)/
	{ return CloseParen }
/\[/
	{ return OpenBracket }
/\]/
	{ return CloseBracket }

/,/
	{ return Comma }
/;/
	{ return Semicolon }
/:/
	{ return Colon }
/==/
	{ return Equal }
/!=/
	{ return NotEqual }
/=/
	{ return Assign }
/\+/
	{ return Plus }
/\-/
	{ return Dash }
/\*/
	{ return Star }
/\//
	{ return Slash }
/</
	{ return LessThan }
/>/
	{ return GreaterThan }
/<=/
	{ return LessEqual }
/>=/
	{ return GreaterEqual }
/&&/
	{ return And }
/\|\|/
	{ return Or }
/\?:/
	{ return Elvis }
/=>/
	{ return Rocket }
/\->/
	{ return Arrow }
/!/
	{ return Not }
/\./
	{ return Dot }
/\$/
	{ return Dollar }

/if/
	{ return If }
/else/
	{ return Else }
/in/
	{ return In }
/as/
	{ return As }
/class/
	{ return Class }
/include/
	{ return Include }
/import/
	{ return Import }
/func/
	{ return Func }

/bool/
	{ return Bool }
/str/
	{ return Str }
/int/
	{ return Int }
/float/
	{ return Float }
/map/
	{ return Map }
/struct/
	{ return Struct }
/variant/
	{ return Variant }
/true/
	{ return True }
/false/
	{ return False }

/#[^\n]*/
	{ return Comment }
/"(\\.|[^"])*"/
	{ return LiteralStr }
/\-?[0-9]+/
	{ return LiteralInt }
/\-?[0-9]+\.[0-9]+/
	{ return LiteralFloat }

/[a-z]([a-z0-9_]*[a-z0-9]+)?/
	{ return Identifier }
/[A-Z]([a-z0-9_]*[a-z0-9]+)?/
	{ return CapitalizedIdentifier }
/[a-z]([a-z0-9:]*[a-z0-9]+)?/
	{ return ResIdentifier }

/./
	{ return Unexpected }

